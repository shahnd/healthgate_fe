{
  "compilerOptions": {
    "target": "ES6",
    "module": "esnext",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
